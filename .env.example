NEXT_PUBLIC_API_URL=http://localhost:8090

# ─── WalletConnect ───────────────────────────────────────────────────────────
# Obtené el tuyo gratis en https://cloud.reown.com → Create Project → AppKit
NEXT_PUBLIC_WC_PROJECT_ID=

# ─── Contratos en Sepolia ────────────────────────────────────────────────────
NEXT_PUBLIC_LKN_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Marketplace P2P — sin esto el approve revierte por "approve to zero address".
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
# Wallet admin de la plataforma (coincide con PLATFORM_ADMIN del backend).
NEXT_PUBLIC_PLATFORM_ADMIN_ADDRESS=

# ─── Chain ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=11155111

# ─── Google ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
